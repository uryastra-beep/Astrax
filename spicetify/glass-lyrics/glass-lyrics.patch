@@ -0,0 +1,69 @@
+// Learned mix start times, keyed by playlist (context) + track: the automix
+// transition for a given track inside a given playlist doesn't change.
+import { atom } from "nanostores";
+import { GL_PREFIX } from "./settings.ts";
+
+const STORAGE_KEY = `${GL_PREFIX}mixTimes`;
+
+type MixTimes = Record<string, number>; // "contextUri|trackUri" -> seconds into the track
+
+function load(): MixTimes {
+  try {
+    const parsed = JSON.parse(Spicetify.LocalStorage.get(STORAGE_KEY) ?? "{}");
+    return parsed && typeof parsed === "object" ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+let times: MixTimes = load();
+/** Number of saved times, for the settings panel. */
+export const $mixTimesCount = atom(Object.keys(times).length);
+
+function save() {
+  Spicetify.LocalStorage.set(STORAGE_KEY, JSON.stringify(times));
+  $mixTimesCount.set(Object.keys(times).length);
+}
+
+export function currentContextUri(): string {
+  const data = Spicetify.Player?.data as any;
+  return data?.context?.uri ?? data?.context_uri ?? "none";
+}
+
+const keyFor = (contextUri: string, trackUri: string) => `${contextUri}|${trackUri}`;
+
+export function getMixTime(contextUri: string, trackUri: string): number | null {
+  const v = times[keyFor(contextUri, trackUri)];
+  return typeof v === "number" && Number.isFinite(v) ? v : null;
+}
+
+export function setMixTime(contextUri: string, trackUri: string, seconds: number) {
+  times[keyFor(contextUri, trackUri)] = Math.round(seconds * 100) / 100;
+  save();
+}
+
+export function clearMixTimes() {
+  times = {};
+  save();
+}
+
+export function exportMixTimes(): string {
+  return JSON.stringify(times, null, 2);
+}
+
+/** Merges valid entries from `json`; returns how many were imported. */
+export function importMixTimes(json: string): number {
+  const parsed = JSON.parse(json);
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new Error("Expected an object of \"context|track\": seconds");
+  }
+  let n = 0;
+  for (const [k, v] of Object.entries(parsed)) {
+    if (k.includes("|") && typeof v === "number" && Number.isFinite(v) && v >= 0) {
+      times[k] = v;
+      n++;
+    }
+  }
+  save();
+  return n;
+}
