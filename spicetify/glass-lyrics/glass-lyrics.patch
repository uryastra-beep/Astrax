+/* Glass Lyrics — crossfade cover transition. Motion itself is WAAPI (transition.ts);
+   this only lays out the stage and hides what it stands in for. */
+
+#SpicyLyricsPage .MediaBox > .GL-CoverStage {
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  pointer-events: none;
+}
+
+#SpicyLyricsPage .GL-CoverStage .GL-StageCover {
+  position: absolute;
+  inset: 0;
+  border-radius: 2cqh;
+  background-size: cover;
+  background-repeat: no-repeat;
+  background-position: center;
+  box-shadow: 0 9px 20px 0 rgba(0, 0, 0, 0.271);
+  will-change: transform, opacity;
+}
+
+#SpicyLyricsPage .GL-CoverStage .GL-Cur {
+  z-index: 1;
+}
+
+#SpicyLyricsPage .GL-CoverStage .GL-Next {
+  z-index: 0;
+}
+
+/* The stage shows the same image in the same box, so hiding Spicy's cover is
+   invisible; it also hides Spicy's own swap animation running underneath. */
+#SpicyLyricsPage .ContentBox .NowBar .Header .MediaBox.GL-Mixing > .MediaImageContainer {
+  opacity: 0 !important;
+}
+
+#SpicyLyricsPage .ContentBox .NowBar .Header .Metadata.GL-MetaHidden {
+  opacity: 0 !important;
+  transition: opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1);
+}
diff --git a/src/custom/index.ts b/src/custom/index.ts
new file mode 100644
index 0000000..ba4a002
--- /dev/null
+++ b/src/custom/index.ts
@@ -0,0 +1,78 @@
+// Glass Lyrics fork — entry point for everything custom.
+// Upstream files only carry two hooks: `onNowBarUpdate` (NowBar.ts) and the
+// <GlassSection> row in the settings panel. Everything else lives here.
+import "./css/glass.css";
+import "./css/transition.css";
+
+import { initCrossfade } from "./crossfade.ts";
+import { currentContextUri, setMixTime } from "./mixTimes.ts";
+import {
+  $glassEnabled,
+  $glassGlow,
+  $glassStroke,
+  $glassUnsungAlpha,
+  $mixEnabled,
+  $mixLearnKey,
+} from "./settings.ts";
+import { initLatency } from "./latency.ts";
+import { initTransition, mixStartTaught } from "./transition.ts";
+
+function applyGlass() {
+  const body = document.body;
+  body.classList.toggle("GL_Glass", $glassEnabled.get());
+  body.style.setProperty("--GL-Stroke", `${$glassStroke.get()}px`);
+  body.style.setProperty("--GL-UnsungAlpha", `${$glassUnsungAlpha.get()}`);
+  body.style.setProperty("--GL-Glow", `${$glassGlow.get()}px`);
+}
+
+const fmt = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, "0")}`;
+
+function onLearnKey(e: KeyboardEvent) {
+  if (!$mixEnabled.get() || e.repeat || e.ctrlKey || e.metaKey || e.altKey) return;
+  const key = $mixLearnKey.get();
+  if (!key || e.key.toLowerCase() !== key.toLowerCase()) return;
+  const t = e.target as HTMLElement | null;
+  if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
+
+  const track = Spicetify.Player?.data?.item?.uri;
+  if (!track) return;
+  const seconds = Spicetify.Player.getProgress() / 1000;
+  const context = currentContextUri();
+  setMixTime(context, track, seconds);
+  const where = context === "none" ? "no playlist" : "in this playlist";
+  Spicetify.showNotification(`Glass Lyrics: mix point saved at ${fmt(seconds)} (${where})`);
+  mixStartTaught();
+}
+
+let initialized = false;
+function init() {
+  if (initialized) return;
+  initialized = true;
+  initCrossfade();
+  initTransition();
+  initLatency();
+  applyGlass();
+  for (const store of [$glassEnabled, $glassStroke, $glassUnsungAlpha, $glassGlow]) store.listen(applyGlass);
+  window.addEventListener("keydown", onLearnKey);
+}
+
+/** Hook: Spicy calls this whenever it (re)renders the NowBar's cover/metadata. */
+export function onNowBarUpdate(_nowBar: Element) {
+  try {
+    init();
+  } catch (err) {
+    console.error("[Glass Lyrics] NowBar hook failed", err);
+  }
+}
+
+// Glass styling and the learn key don't depend on the NowBar being open.
+const spicetifyReady = () =>
+  typeof Spicetify !== "undefined" && !!Spicetify.Player?.addEventListener && !!Spicetify.Platform;
+if (spicetifyReady()) init();
+else {
+  const wait = setInterval(() => {
+    if (!spicetifyReady()) return;
+    clearInterval(wait);
+    init();
+  }, 300);
+}
diff --git a/src/custom/latency.ts b/src/custom/latency.ts
new file mode 100644
index 0000000..56017fa
--- /dev/null
+++ b/src/custom/latency.ts
@@ -0,0 +1,61 @@
+// Per-output-device audio latency. Bluetooth sits 150-250ms behind wired, so a
+// single fixed lead can't suit both. Nudge with "," (earlier) and "." (later);
+// the value is remembered per output device label.
+import { setOutputLatency } from "../utils/Gets/GetProgress.ts";
+
+const KEY = "GL:latencyByDevice";
+const DEFAULT_MS = 100;
+const STEP = 10;
+let device = "default";
+let table: Record<string, number> = {};
+
+function load() {
+  try {
+    table = JSON.parse(Spicetify.LocalStorage.get(KEY) || "{}") || {};
+  } catch {
+    table = {};
+  }
+}
+
+function apply() {
+  setOutputLatency(table[device] ?? DEFAULT_MS);
+}
+
+async function detectDevice() {
+  try {
+    const list = await navigator.mediaDevices.enumerateDevices();
+    const out = list.find((d) => d.kind === "audiooutput" && d.deviceId === "default") ??
+      list.find((d) => d.kind === "audiooutput");
+    const next = out?.label || "default";
+    if (next !== device) {
+      device = next;
+      apply();
+    }
+  } catch {
+    /* no device info: keep the shared default */
+  }
+}
+
+function onKey(e: KeyboardEvent) {
+  if (e.repeat || e.ctrlKey || e.metaKey || e.altKey) return;
+  if (e.key !== "," && e.key !== ".") return;
+  const t = e.target as HTMLElement | null;
+  if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
+  const next = (table[device] ?? DEFAULT_MS) + (e.key === "." ? STEP : -STEP);
+  table[device] = Math.max(-200, Math.min(600, next));
+  try {
+    Spicetify.LocalStorage.set(KEY, JSON.stringify(table));
+  } catch {
+    /* not persisted */
+  }
+  apply();
+  Spicetify.showNotification(`Glass Lyrics: lead ${table[device]}ms (${device})`);
+}
+
+export function initLatency() {
+  load();
+  apply();
+  detectDevice();
+  setInterval(detectDevice, 5000);
+  window.addEventListener("keydown", onKey);
+}
