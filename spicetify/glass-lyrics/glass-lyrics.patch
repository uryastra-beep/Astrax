-const PROGRESS_POSITION_OFFSET = 100;
+let PROGRESS_POSITION_OFFSET = 100;
+/** Per-output-device latency lead (ms), set by custom/latency.ts. */
+export const setOutputLatency = (ms: number) => {
+  PROGRESS_POSITION_OFFSET = ms;
+};
 // Deltas within this window are treated as jitter and smoothed; larger deltas
 // (seeks/track changes) snap immediately. Kept well below any deliberate seek (>=1s).
 const JITTER_RESYNC_THRESHOLD = 500;
@@ -137,6 +141,53 @@ function normalizeProgress(position: number, isPlaying: boolean): number {
   return predicted;
 }
 
+// --- 2s drift auditor -------------------------------------------------------
+// Lyrics are timed in absolute ms, so a tempo change in the song never moves
+// them; what moves is the *clock* (stalled source, output-latency shifts,
+// crossfades). Every AUDIT_INTERVAL the auditor compares the lyric clock with
+// the player's own independent estimate. The steady gap between the two is
+// the calibrated lead and is left alone; only a *change* in that gap (relative
+// drift) is corrected, gently, so the calibration is never fought.
+const AUDIT_INTERVAL = 2000;
+// Relative drift below this is noise from the two sources' jitter.
