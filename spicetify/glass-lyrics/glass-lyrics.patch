@@ -0,0 +1,48 @@
+// Glass Lyrics settings. Stored under their own "GL:" keys so they never touch
+// Spicy Lyrics' "SL:settings" blob (clean upstream merges, and either extension
+// can be swapped back in without leftovers).
+import { atom, type WritableAtom } from "nanostores";
+
+export const GL_PREFIX = "GL:";
+
+function read<T>(key: string, fallback: T): T {
+  try {
+    const raw = Spicetify.LocalStorage.get(GL_PREFIX + key);
+    if (raw === null || raw === undefined) return fallback;
+    const parsed = JSON.parse(raw);
+    return typeof parsed === typeof fallback ? parsed : fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+function glAtom<T>(key: string, fallback: T): WritableAtom<T> {
+  const store = atom<T>(read(key, fallback));
+  store.listen((v) => {
+    try {
+      Spicetify.LocalStorage.set(GL_PREFIX + key, JSON.stringify(v));
+    } catch {
+      /* storage full or unavailable: the setting just won't persist */
+    }
+  });
+  return store;
+}
+
+export const DEFAULTS = {
+  glassEnabled: true,
+  glassStroke: 0.6, // px
+  glassUnsungAlpha: 0.18,
+  glassGlow: 19, // px
+  mixEnabled: true,
+  mixLearnKey: "m",
+  mixManualSeconds: 0, // 0 = read the crossfade length from Spotify
+};
+
+export const $glassEnabled = glAtom("glassEnabled", DEFAULTS.glassEnabled);
+export const $glassStroke = glAtom("glassStroke", DEFAULTS.glassStroke);
+export const $glassUnsungAlpha = glAtom("glassUnsungAlpha", DEFAULTS.glassUnsungAlpha);
+export const $glassGlow = glAtom("glassGlow", DEFAULTS.glassGlow);
+
+export const $mixEnabled = glAtom("mixEnabled", DEFAULTS.mixEnabled);
+export const $mixLearnKey = glAtom("mixLearnKey", DEFAULTS.mixLearnKey);
+export const $mixManualSeconds = glAtom("mixManualSeconds", DEFAULTS.mixManualSeconds);
diff --git a/src/custom/transition.ts b/src/custom/transition.ts
new file mode 100644
index 0000000..ec93314
--- /dev/null
+++ b/src/custom/transition.ts
@@ -0,0 +1,378 @@
+// Feature 1 — cover transition during a crossfade / automix.
+//
+//   begin:  title fades → next cover rises from behind the
+//           current one; both shrink and stack, the current one dims.
+//   finish: next cover drops into place full size, the old one leaves downward,
+//           title comes back.
+//
+// When it begins, in priority order:
+//   1. a learned start time for this track in this playlist (mixTimes.ts),
+//   2. track end minus Spotify's crossfade length,
+//   3. fallback: the whole sequence runs on `songchange`.
+// When it finishes: on `songchange`, delayed by however much of the previous
+// track was still left when the event fired (if Spotify switches tracks at the
+// start of the fade, that remainder *is* the rest of the fade).
+import { getCrossfade } from "./crossfade.ts";
+import { currentContextUri, getMixTime } from "./mixTimes.ts";
+import { $mixEnabled } from "./settings.ts";
+
+const EASE = "cubic-bezier(.22,1,.36,1)";
+const STACK_SCALE = 0.72;
+const CUR_DIM = 0.55;
+const TICK_MS = 250;
+const SEEK_BACK_TOLERANCE = 1.5; // s before the start point that cancels a running mix
+const UNKNOWN_MIX_LENGTH = 12; // s, for automix without a learned time
+
+type Phase = "idle" | "mixing" | "finishing" | "cancelling";
+
+const s = {
+  phase: "idle" as Phase,
+  token: 0,
+  trackUri: null as string | null,
+  coverUrl: null as string | null, // current track's cover, tracked on every tick
+  startAt: null as number | null, // where the running mix began (s into the track)
+  beganAt: 0, // performance.now() when begin() ran
+  nextUrl: null as string | null,
+  nextPreload: null as Promise<void> | null,
+  // last known position, for measuring how early `songchange` fires
+  lastProgress: 0,
+  lastDuration: 0,
+  lastTrack: null as string | null,
+  stage: null as HTMLDivElement | null,
+  cur: null as HTMLDivElement | null,
+  next: null as HTMLDivElement | null,
+  timers: [] as number[],
+};
+
+const BEGIN_TOTAL_MS = 450 + 1000 + 600;
+
+const log = (...a: unknown[]) => console.debug("[Glass Lyrics] [Mix]", ...a);
+
+function toHttps(url: string | undefined | null): string | null {
+  if (!url) return null;
+  if (url.startsWith("spotify:image:")) return `https://i.scdn.co/image/${url.slice(14)}`;
+  return url.startsWith("http") ? url : null;
+}
+
+function pickImage(images: any[] | undefined): string | null {
+  if (!Array.isArray(images) || !images.length) return null;
+  const by = (label: string) => images.find((i) => i?.label === label)?.url;
+  return toHttps(by("xlarge") ?? by("large") ?? images[0]?.url);
+}
+
+function currentCover(): string | null {
+  const item = Spicetify.Player?.data?.item as any;
+  return pickImage(item?.images ?? item?.show?.images);
+}
+
+function nextCover(): string | null {
+  const data = Spicetify.Player?.data as any;
+  const fromPlayer = pickImage(data?.nextItems?.[0]?.images);
+  if (fromPlayer) return fromPlayer;
+  const meta = (Spicetify.Queue as any)?.nextTracks?.[0]?.contextTrack?.metadata;
+  return toHttps(meta?.image_xlarge_url ?? meta?.image_large_url ?? meta?.image_url);
+}
+
+function preload(url: string): Promise<void> {
+  return new Promise((resolve) => {
+    const img = new Image();
+    img.onload = img.onerror = () => resolve();
+    img.src = url;
+  });
+}
+
+const withTimeout = (p: Promise<void> | null, ms: number) =>
+  Promise.race([p ?? Promise.resolve(), new Promise<void>((r) => setTimeout(r, ms))]);
+
+function later(fn: () => void, ms: number) {
+  s.timers.push(window.setTimeout(fn, ms));
+}
+
+function clearTimers() {
+  s.timers.forEach(clearTimeout);
+  s.timers = [];
+}
+
+function nowBarParts() {
+  const nowBar = document.querySelector<HTMLElement>("#SpicyLyricsPage .ContentBox .NowBar");
+  const mediaBox = nowBar?.querySelector<HTMLElement>(".Header .MediaBox") ?? null;
+  const metadata = nowBar?.querySelector<HTMLElement>(".Header .Metadata") ?? null;
+  const container = mediaBox?.querySelector<HTMLElement>(".MediaImageContainer") ?? null;
+  const page = nowBar?.closest<HTMLElement>("#SpicyLyricsPage") ?? null;
+  const visible =
+    !!nowBar &&
+    nowBar.classList.contains("Active") &&
+    !page?.classList.contains("CardMode") &&
+    nowBar.getBoundingClientRect().width > 0;
+  return { nowBar, mediaBox, metadata, container, visible };
+}
+
+function anim(el: Element | null, frames: Keyframe[], ms: number, delay = 0) {
+  return el?.animate(frames, { duration: ms, delay, easing: EASE, fill: "forwards" });
+}
+
+function buildStage(mediaBox: HTMLElement, curUrl: string, nextUrl: string) {
+  s.stage?.remove();
+  const stage = document.createElement("div");
+  stage.className = "GL-CoverStage";
+  stage.innerHTML = `<div class="GL-StageCover GL-Next"></div><div class="GL-StageCover GL-Cur"></div>`;
+  s.next = stage.querySelector(".GL-Next");
+  s.cur = stage.querySelector(".GL-Cur");
+  s.cur!.style.backgroundImage = `url("${curUrl}")`;
+  s.next!.style.backgroundImage = `url("${nextUrl}")`;
+  s.next!.style.opacity = "0";
+  mediaBox.appendChild(stage);
+  s.stage = stage;
+}
+
+function teardown() {
+  clearTimers();
+  s.stage?.remove();
+  s.stage = s.cur = s.next = null;
+  const { mediaBox, metadata } = nowBarParts();
+  mediaBox?.classList.remove("GL-Mixing");
+  metadata?.classList.remove("GL-MetaHidden");
+  s.phase = "idle";
+  s.startAt = null;
+}
+
+/** Phases 1–4. `speed` < 1 compresses the timings (used by the songchange fallback). */
+async function begin(curUrl: string, nextUrl: string, speed = 1, immediateStage = false) {
+  const { mediaBox, metadata, container, visible } = nowBarParts();
+  if (!visible || !mediaBox || !container) return false;
+  const token = ++s.token;
+  s.phase = "mixing";
+  s.beganAt = performance.now();
+  const t = (ms: number) => ms * speed;
+  log("begin", { curUrl, nextUrl, speed });
+
+  // 1-2. title fades
+  later(() => metadata?.classList.add("GL-MetaHidden"), t(150));
+
+  // On songchange Spicy starts its own cover swap right away; cover it at once.
+  if (immediateStage) {
+    buildStage(mediaBox, curUrl, nextUrl);
+    mediaBox.classList.add("GL-Mixing");
+  }
+
+  await Promise.all([
+    new Promise((r) => setTimeout(r, t(450))),
+    withTimeout(nextUrl === s.nextUrl ? s.nextPreload : preload(nextUrl), t(1200)),
+  ]);
+  if (token !== s.token || !mediaBox.isConnected) return false;
+
+  // 3. stage the two covers over the real one (same image, same box → no jump)
+  if (!immediateStage) {
+    buildStage(mediaBox, curUrl, nextUrl);
+    mediaBox.classList.add("GL-Mixing");
+  }
+  anim(s.cur, [
+    { transform: "translateY(0) scale(1)" },
+    { transform: `translateY(26%) scale(${STACK_SCALE})` },
+  ], t(1000));
+  anim(s.next, [
+    { transform: "translateY(6%) scale(0.62)", opacity: 0 },
+    { transform: "translateY(-52%) scale(0.72)", opacity: 1 },
+  ], t(1000));
+  // 4. the outgoing cover dims while the mix plays
+  anim(s.cur, [{ opacity: 1 }, { opacity: CUR_DIM }], t(600), t(900));
+  return true;
+}
+
+/** Phases 5–6. */
+function finish() {
+  if (s.phase !== "mixing" || !s.stage?.isConnected) {
+    teardown();
+    return;
+  }
+  const token = s.token;
+  s.phase = "finishing";
+  log("finish");
+
+  // The track that actually came on may not be the one we preloaded (shuffle, queue edits).
+  const actual = currentCover();
+  if (actual && s.next && actual !== s.nextUrl) s.next.style.backgroundImage = `url("${actual}")`;
+
+  // 5. next drops to the centre at full size, the old one leaves downward
+  if (s.next) s.next.style.zIndex = "2";
+  anim(s.next, [{ transform: "translateY(0) scale(1)", opacity: 1 }], 850);
+  anim(s.cur, [{ transform: `translateY(72%) scale(${STACK_SCALE})`, opacity: 0 }], 750);
+
+  // 6. title comes back
+  later(() => {
+    if (token !== s.token) return;
+    nowBarParts().metadata?.classList.remove("GL-MetaHidden");
+  }, 650);
+
+  // Hand back to Spicy's own cover once it shows the new image and its own
+  // crossfade has settled underneath us; then the stage can go.
+  const started = performance.now();
+  const handBack = () => {
+    if (token !== s.token) return;
+    const { container } = nowBarParts();
+    const want = Spicetify.Player?.data?.item?.images?.find((i: any) => i.label === "xlarge")?.url;
+    const toImage = container?.querySelector(".ti_ToImage");
+    const settled =
+      !!container &&
+      (!want || container.getAttribute("last-image") === want) &&
+      (!toImage || (toImage.classList.contains("MB_hidden") && !toImage.classList.contains("MB_anim_enter")));
+    if ((settled && performance.now() - started > 900) || performance.now() - started > 4000) {
+      teardown();
+      return;
+    }
+    later(handBack, 120);
+  };
+  later(handBack, 900);
+}
+
+/** Seeked back before the start point: undo phases 1–4. */
+function cancel() {
+  if (s.phase !== "mixing") return;
+  log("cancel");
+  s.phase = "cancelling";
+  const token = ++s.token;
+  clearTimers();
+  anim(s.next, [{ transform: "translateY(6%) scale(0.62)", opacity: 0 }], 600);
+  anim(s.cur, [{ transform: "translateY(0) scale(1)", opacity: 1 }], 700);
+  nowBarParts().metadata?.classList.remove("GL-MetaHidden");
+  later(() => token === s.token && teardown(), 720);
+}
+
+function startPoint(trackUri: string, durationS: number): { at: number | null; length: number } {
+  const learned = getMixTime(currentContextUri(), trackUri);
+  if (learned !== null && learned < durationS) return { at: learned, length: durationS - learned };
+  const cf = getCrossfade();
+  if (cf.seconds) return { at: Math.max(0, durationS - cf.seconds), length: cf.seconds };
+  return { at: null, length: UNKNOWN_MIX_LENGTH };
+}
+
+function onTrackStart() {
+  s.trackUri = Spicetify.Player?.data?.item?.uri ?? null;
+  s.coverUrl = currentCover();
+  s.nextUrl = nextCover();
+  s.nextPreload = s.nextUrl ? preload(s.nextUrl) : null;
+}
+
+function tick() {
+  const uri = Spicetify.Player?.data?.item?.uri ?? null;
+  if (uri !== s.trackUri) onTrackStart();
+  else {
+    // The queue can change mid-song; keep the preloaded "next" in sync.
+    const next = nextCover();
+    if (next && next !== s.nextUrl) {
+      s.nextUrl = next;
+      s.nextPreload = preload(next);
+    }
+  }
+
+  const cf = getCrossfade();
+  if (!$mixEnabled.get() || !cf.active) {
+    if (s.phase === "mixing") cancel();
+    return;
+  }
+  if (!uri || Spicetify.Player?.data?.isPaused) return;
+
+  const progress = Spicetify.Player.getProgress() / 1000;
+  const duration = Spicetify.Player.getDuration() / 1000;
+  if (!(duration > 0)) return;
+  const { at } = startPoint(uri, duration);
+
+  if (s.phase === "idle" && at !== null && progress >= at && progress < duration - 0.4) {
+    if (s.coverUrl && s.nextUrl && nowBarParts().visible) {
+      s.startAt = at;
+      void begin(s.coverUrl, s.nextUrl);
+    }
+  } else if (s.phase === "mixing" && s.startAt !== null && progress < s.startAt - SEEK_BACK_TOLERANCE) {
+    cancel();
+  }
+}
+
+/** Call right after the user teaches a new start point: start the mix now. */
+export function mixStartTaught() {
+  if (s.phase === "idle") tick();
+}
+
+function onSongChange() {
+  // How much of the previous track was left when Spotify switched tracks.
+  const lead = s.lastDuration > 0 ? Math.max(0, (s.lastDuration - s.lastProgress) / 1000) : NaN;
+  const prevTrack = s.lastTrack;
+  const prevDurationS = s.lastDuration / 1000;
+  const oldCover = s.coverUrl;
+  recordLead(lead);
+
+  const cf = getCrossfade();
+  const enabled = $mixEnabled.get() && cf.active;
+  const mixLength = prevTrack ? startPoint(prevTrack, prevDurationS).length : UNKNOWN_MIX_LENGTH;
+  const natural = Number.isFinite(lead) && lead <= mixLength + 1.5; // not a manual skip
+
+  onTrackStart();
+  s.lastProgress = 0;
+  s.lastDuration = Spicetify.Player.getDuration?.() ?? 0;
+  s.lastTrack = s.trackUri;
+
+  if (s.phase === "finishing" || s.phase === "cancelling") teardown();
+
+  if (s.phase === "mixing") {
+    if (!natural) return finish();
+    const sinceBegin = performance.now() - s.beganAt;
+    const wait = Math.max(lead * 1000 - 200, BEGIN_TOTAL_MS - sinceBegin, 0);
+    const token = s.token;
+    later(() => token === s.token && finish(), wait);
+    return;
+  }
+
+  // 3. fallback: nothing started before the switch — run the whole thing now.
+  if (enabled && natural && oldCover && s.coverUrl && oldCover !== s.coverUrl) {
+    const quick = lead < 2;
+    void begin(oldCover, s.coverUrl, quick ? 0.6 : 1, true).then((ok) => {
+      if (!ok) return;
+      const token = s.token;
+      const wait = Math.max(lead * 1000 - 200, BEGIN_TOTAL_MS * (quick ? 0.6 : 1));
+      later(() => token === s.token && finish(), wait);
+    });
+  }
+}
+
+// --- songchange timing measurement -----------------------------------------
+// Answers "does songchange fire at the start or the end of the fade?" with real
+// numbers: each entry is how many seconds of the previous track were left.
+const LEAD_KEY = "GL:songchangeLead";
+function recordLead(lead: number) {
+  if (!Number.isFinite(lead)) return;
+  const cf = getCrossfade();
+  log(`songchange with ${lead.toFixed(2)}s of the previous track left`, cf);
+  try {
+    const list = JSON.parse(Spicetify.LocalStorage.get(LEAD_KEY) ?? "[]");
+    list.push({ lead: Math.round(lead * 100) / 100, crossfade: cf.seconds, active: cf.active, at: Date.now() });
+    Spicetify.LocalStorage.set(LEAD_KEY, JSON.stringify(list.slice(-30)));
+  } catch {
+    /* measurement only */
+  }
+}
+
+export function isTransitionBusy() {
+  return s.phase !== "idle";
+}
+
+let initialized = false;
+export function initTransition() {
+  if (initialized) return;
+  initialized = true;
+  onTrackStart();
+  s.lastTrack = s.trackUri;
+  s.lastDuration = Spicetify.Player.getDuration?.() ?? 0;
+
+  Spicetify.Player.addEventListener("onprogress", (e: any) => {
+    // Ignore progress from a track whose songchange hasn't been handled yet.
+    if ((Spicetify.Player?.data?.item?.uri ?? null) !== s.lastTrack) return;
+    if (typeof e?.data === "number") s.lastProgress = e.data;
+    const d = Spicetify.Player.getDuration?.();
+    if (d) s.lastDuration = d;
+  });
+  Spicetify.Player.addEventListener("songchange", onSongChange);
+  setInterval(tick, TICK_MS);
+
+  $mixEnabled.listen((on) => {
+    if (!on && s.phase !== "idle") teardown();
+  });
+}
diff --git a/src/utils/Gets/GetProgress.ts b/src/utils/Gets/GetProgress.ts
index d9e0648..6acb625 100644
--- a/src/utils/Gets/GetProgress.ts
+++ b/src/utils/Gets/GetProgress.ts
@@ -49,7 +49,11 @@ let canSyncNonLocalTimestamp = SpotifyPlayer?.IsPlaying ? syncTimings.length : 0
 // Forward lead (ms) added to every position to compensate for audio-output
 // latency. A perceptual dial, not a correctness value: raise it if the sweep
