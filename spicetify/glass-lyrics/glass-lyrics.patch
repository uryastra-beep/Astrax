diff --git a/src/custom/GlassSection.tsx b/src/custom/GlassSection.tsx
new file mode 100644
index 0000000..f1685e1
--- /dev/null
+++ b/src/custom/GlassSection.tsx
@@ -0,0 +1,163 @@
+import { useStore } from "@nanostores/react";
+import React, { useState } from "react";
+import {
+  matches,
+  Row,
+  SectionTitle,
+  Slider,
+  Toggle,
+} from "../components/ReactComponents/SettingsPanel/components.tsx";
+import { getCrossfade } from "./crossfade.ts";
+import { $mixTimesCount, clearMixTimes, exportMixTimes, importMixTimes } from "./mixTimes.ts";
+import {
+  $glassEnabled,
+  $glassGlow,
+  $glassStroke,
+  $glassUnsungAlpha,
+  $mixEnabled,
+  $mixLearnKey,
+  $mixManualSeconds,
+  DEFAULTS,
+} from "./settings.ts";
+
+export const GLASS_SECTION_NAME = "Glass Lyrics";
+
+interface Props {
+  query: string;
+  sectionFilter: string;
+}
+
+const ROWS = {
+  glass: ["Glass lyrics", "Glassmorphism on the text: glass outline, translucent unsung words and a glow on sung ones."],
+  glassStroke: ["Glass outline", "Thickness of the letter outline."],
+  glassAlpha: ["Unsung transparency", "Fill opacity of the words that haven't been sung yet."],
+  glassGlow: ["Glow", "Glow radius on sung words."],
+  mix: ["Crossfade transition", "Cover animation when Spotify mixes one song into the next."],
+  mixKey: ["Learn key", "Saves the current moment as the mix start point for this song in this playlist."],
+  mixManual: ["Manual crossfade", "Mix length if Spotify doesn't expose it. 0 = use Spotify's."],
+  mixData: ["Saved mix points", "Export, import or delete the learned mix points."],
+} as const;
+
+export default function GlassSection({ query, sectionFilter }: Props) {
+  const glassEnabled = useStore($glassEnabled);
+  const glassStroke = useStore($glassStroke);
+  const glassAlpha = useStore($glassUnsungAlpha);
+  const glassGlow = useStore($glassGlow);
+  const mixEnabled = useStore($mixEnabled);
+  const mixKey = useStore($mixLearnKey);
+  const mixManual = useStore($mixManualSeconds);
+  const mixCount = useStore($mixTimesCount);
+  const [json, setJson] = useState("");
+  const [status, setStatus] = useState("");
+
+  if (sectionFilter !== "All" && sectionFilter !== GLASS_SECTION_NAME) return null;
+  const show = Object.fromEntries(
+    Object.entries(ROWS).map(([k, [label, desc]]) => [k, matches(query, label, desc)])
+  ) as Record<keyof typeof ROWS, boolean>;
+  if (!Object.values(show).some(Boolean)) return null;
+
+  const cf = getCrossfade();
+  const cfLabel =
+    cf.source === "none"
+      ? "Spotify doesn't expose the crossfade: use the manual value."
+      : `Now: ${cf.active ? "on" : "off"}${cf.seconds ? ` · ${cf.seconds}s` : ""} (${cf.source === "manual" ? "manual" : "Spotify"})`;
+
+  const doExport = async () => {
+    const data = exportMixTimes();
+    setJson(data);
+    try {
+      await (Spicetify.Platform?.ClipboardAPI?.copy?.(data) ?? navigator.clipboard.writeText(data));
+      setStatus("Copied to the clipboard.");
+    } catch {
+      setStatus("Copy it from the box below.");
+    }
+  };
+  const doImport = () => {
+    try {
+      const n = importMixTimes(json);
+      setStatus(`Imported ${n} mix points.`);
+    } catch (err) {
+      setStatus(`Invalid JSON: ${(err as Error).message}`);
+    }
+  };
+  const doClear = () => {
+    clearMixTimes();
+    setStatus("Mix points deleted.");
+  };
+
+  return (
+    <>
+      <SectionTitle>{GLASS_SECTION_NAME}</SectionTitle>
+
+      {show.glass && (
+        <Row label={ROWS.glass[0]} description={ROWS.glass[1]}>
+          <Toggle checked={glassEnabled} onChange={(v) => $glassEnabled.set(v)} />
+        </Row>
+      )}
+      {show.glassStroke && (
+        <Row label={ROWS.glassStroke[0]} description={ROWS.glassStroke[1]} disabled={!glassEnabled} stacked>
+          <Slider value={glassStroke} min={0} max={2} step={0.1} defaultValue={DEFAULTS.glassStroke} unit="px"
+            onChange={(v) => $glassStroke.set(v)} disabled={!glassEnabled} />
+        </Row>
+      )}
+      {show.glassAlpha && (
+        <Row label={ROWS.glassAlpha[0]} description={ROWS.glassAlpha[1]} disabled={!glassEnabled} stacked>
+          <Slider value={glassAlpha} min={0} max={0.6} step={0.01} defaultValue={DEFAULTS.glassUnsungAlpha}
+            onChange={(v) => $glassUnsungAlpha.set(v)} disabled={!glassEnabled} />
+        </Row>
+      )}
+      {show.glassGlow && (
+        <Row label={ROWS.glassGlow[0]} description={ROWS.glassGlow[1]} disabled={!glassEnabled} stacked>
+          <Slider value={glassGlow} min={0} max={40} step={1} defaultValue={DEFAULTS.glassGlow} unit="px"
+            onChange={(v) => $glassGlow.set(v)} disabled={!glassEnabled} />
+        </Row>
+      )}
+
+      {show.mix && (
+        <Row label={ROWS.mix[0]} description={`${ROWS.mix[1]} ${cfLabel}`}>
+          <Toggle checked={mixEnabled} onChange={(v) => $mixEnabled.set(v)} />
+        </Row>
+      )}
+      {show.mixKey && (
+        <Row label={ROWS.mixKey[0]} description={ROWS.mixKey[1]} disabled={!mixEnabled}>
+          <input
+            className="sl-sp-select"
+            style={{ width: "4em", textAlign: "center", textTransform: "uppercase" }}
+            value={mixKey}
+            maxLength={1}
+            disabled={!mixEnabled}
+            onChange={(e) => {
+              const k = e.currentTarget.value.trim().toLowerCase();
+              if (k) $mixLearnKey.set(k);
+            }}
+          />
+        </Row>
+      )}
+      {show.mixManual && (
+        <Row label={ROWS.mixManual[0]} description={ROWS.mixManual[1]} disabled={!mixEnabled} stacked>
+          <Slider value={mixManual} min={0} max={12} step={1} defaultValue={DEFAULTS.mixManualSeconds} unit="s"
+            onChange={(v) => $mixManualSeconds.set(v)} disabled={!mixEnabled} />
+        </Row>
+      )}
+      {show.mixData && (
+        <Row label={ROWS.mixData[0]} description={`${ROWS.mixData[1]} Saved: ${mixCount}.`} stacked>
+          <div style={{ display: "flex", flexDirection: "column", gap: 8, width: "100%" }}>
+            <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
+              <button type="button" className="sl-sp-btn" onClick={doExport}>Export</button>
+              <button type="button" className="sl-sp-btn" onClick={doImport} disabled={!json.trim()}>Import</button>
+              <button type="button" className="sl-sp-btn" onClick={doClear} disabled={mixCount === 0}>Delete all</button>
+            </div>
+            <textarea
+              className="sl-sp-select"
+              style={{ width: "100%", minHeight: 80, fontFamily: "monospace", resize: "vertical" }}
+              placeholder='Paste the JSON to import here: {"spotify:playlist:…|spotify:track:…": 192.4}'
+              value={json}
+              onChange={(e) => setJson(e.currentTarget.value)}
+            />
+            {status && <span className="sl-sp-description">{status}</span>}
+          </div>
+        </Row>
+      )}
+    </>
+  );
+}
diff --git a/src/custom/crossfade.ts b/src/custom/crossfade.ts
new file mode 100644
index 0000000..b574641
--- /dev/null
+++ b/src/custom/crossfade.ts
@@ -0,0 +1,60 @@
+// Reads Spotify's own crossfade / automix settings.
+//
+// Source (Spotify 1.2.96 xpui bundle, not a documented API):
+//   Spicetify.Platform.SettingsAPI.playback.audioCrossfade    -> pref "audio.crossfade_v2"      (bool)
+//   Spicetify.Platform.SettingsAPI.playback.audioCrossfadeMs  -> pref "audio.crossfade.time_v2" (ms)
+//   Spicetify.Platform.SettingsAPI.playback.autoMix           -> pref "audio.automix"           (bool)
+// Each is a PrefValue with async getValue() and subValue(cb). If any of it is
+// missing, the manual "crossfade seconds" setting takes over.
+import { $mixManualSeconds } from "./settings.ts";
+
+type PrefValue<T> = {
+  getValue: () => Promise<T>;
+  subValue?: (cb: (v: T) => void) => unknown;
+};
+
+const state = {
+  apiAvailable: false,
+  crossfade: false,
+  crossfadeMs: 0,
+  automix: false,
+};
+
+function watch<T>(pref: PrefValue<T> | undefined, apply: (v: T) => void) {
+  if (!pref?.getValue) return false;
+  pref.getValue().then(apply, () => {});
+  try {
+    pref.subValue?.(apply);
+  } catch {
+    /* no live updates; the value read at startup still stands */
+  }
+  return true;
+}
+
+export function initCrossfade() {
+  const playback = Spicetify.Platform?.SettingsAPI?.playback;
+  const a = watch<boolean>(playback?.audioCrossfade, (v) => (state.crossfade = !!v));
+  const b = watch<number | bigint>(playback?.audioCrossfadeMs, (v) => (state.crossfadeMs = Number(v) || 0));
+  watch<boolean>(playback?.autoMix, (v) => (state.automix = !!v));
+  state.apiAvailable = a && b;
+}
+
+export type CrossfadeInfo = {
+  /** A crossfade/automix transition is expected between tracks. */
+  active: boolean;
+  /** Fixed crossfade length if known (automix decides its own length). */
+  seconds: number | null;
+  source: "manual" | "spotify" | "none";
+};
+
+export function getCrossfade(): CrossfadeInfo {
+  const manual = $mixManualSeconds.get();
+  if (manual > 0) return { active: true, seconds: manual, source: "manual" };
+  if (!state.apiAvailable) return { active: false, seconds: null, source: "none" };
+  const seconds = state.crossfade && state.crossfadeMs > 0 ? state.crossfadeMs / 1000 : null;
+  return { active: state.crossfade || state.automix, seconds, source: "spotify" };
+}
+
+export function getCrossfadeDebug() {
+  return { ...state };
+}
diff --git a/src/custom/css/glass.css b/src/custom/css/glass.css
new file mode 100644
index 0000000..bf8091f
--- /dev/null
+++ b/src/custom/css/glass.css
@@ -0,0 +1,48 @@
+/* Glass Lyrics — "letras de vidrio".
+   Only paint is changed: colors, stroke and shadows. No property here affects
+   layout (text-stroke draws on top of the glyph, shadows don't take space), and
+   nothing touches transform/scale/opacity, which the animator owns.
+
+   Spicy pins `--gradient-alpha-end` with !important on `.line`, so these rules
+   need !important plus higher specificity (the extra `body.GL_Glass`).
+   Values come from the settings panel through --GL-* on <body>. */
+
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line,
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line .word,
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line .letter {
+  --gradient-alpha-end: var(--GL-UnsungAlpha, 0.18) !important;
+  -webkit-text-stroke: var(--GL-Stroke, 0.6px) rgba(255, 255, 255, 0.5);
+}
+
+/* Static lyrics have no "unsung" part: Spicy draws them fully lit. Keep that. */
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line.static {
+  --gradient-alpha-end: 1 !important;
+}
+
+/* Sung lines: Spicy draws the glyph itself as a zero-offset text-shadow (the
+   fill is transparent and they carry no background-image), so the glow is
+   appended as a second shadow instead of replacing the first. */
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line.Sung,
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line.Sung .word,
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line.Sung .letter {
+  text-shadow:
+    0 0 var(--BlurAmount, 0)
+      rgba(var(--gradient-color), var(--gradient-color), var(--gradient-color), var(--gradient-alpha)),
+    var(--ActiveTextGlowDef);
+}
+
+/* Active line: the animator drives --text-shadow-opacity per word/letter (0%
+   before it's sung, rising while it's sung, held after). The glass glow rides
+   on that value, so it only lights what has actually been sung. */
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line.Active,
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line.Active .word,
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line.Active .letter,
+body.GL_Glass #SpicyLyricsPage.SpicyRenderer .LyricsContainer .LyricsContent .line.Active .letterGroup {
+  text-shadow:
+    0 0 var(--text-shadow-blur-radius) rgba(255, 255, 255, var(--text-shadow-opacity)),
+    0 0 var(--GL-Glow, 19px) rgba(255, 255, 255, min(55%, calc(var(--text-shadow-opacity) * 1.6)));
+}
+
+body.GL_Glass #SpicyLyricsPage .LyricsContainer .LyricsContent {
+  --ActiveTextGlowDef: rgba(255, 255, 255, 0.55) 0 0 var(--GL-Glow, 19px);
+}
diff --git a/src/custom/css/transition.css b/src/custom/css/transition.css
