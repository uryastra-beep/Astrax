# serpantinum: uses the terminal's 16 colors (kitty/colors.conf), which
# Serpantinum regenerates on every theme -> micro always matches the theme.
# 2 mauve · 3 peach · 4 lilac · 1 red · 8 grey · 15 text · 12 light lilac
# 10 light mauve · 13 medium purple · 0 dark surface
color-link default "15,default"
color-link comment "italic 8,default"
color-link identifier "4,default"
color-link identifier.class "bold 10,default"
color-link identifier.var "15,default"
color-link constant "3,default"
color-link constant.number "3,default"
color-link constant.string "11,default"
color-link symbol "12,default"
color-link symbol.brackets "7,default"
color-link symbol.tag "2,default"
color-link type "10,default"
color-link type.keyword "2,default"
color-link type.extended "10,default"
color-link special "3,default"
color-link statement "bold 2,default"
color-link preproc "13,default"
color-link underlined "underline 4,default"
color-link error "bold 1,default"
color-link todo "bold 0,3"
color-link diff-added "2,default"
color-link diff-modified "3,default"
color-link diff-deleted "1,default"
color-link gutter-error "1,default"
color-link gutter-warning "3,default"
color-link statusline "bold 2,0"
color-link tabbar "15,0"
color-link indent-char "0,default"
color-link line-number "8,default"
color-link current-line-number "bold 2,default"
color-link cursor-line "0"
color-link color-column "0"
color-link selection "0,12"
color-link scrollbar "2,default"
color-link match-brace "bold 0,2"
color-link message "2,default"
color-link error-message "bold 1,default"
