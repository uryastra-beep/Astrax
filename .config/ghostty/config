# ── ghostty · serpantinum ───────────────────────────────────────────
# Colors: serpantinum-colors is generated by ~/scripts/ghostty-colors.sh from the
# active theme (Serpantinum calls it on every theme change).
config-file = serpantinum-colors

# font (the one from the Serpantinum bar)
font-family = Iosevka Nerd Font
font-size = 12.5

# window
background-opacity = 0.6
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-decoration = false
gtk-titlebar = false
confirm-close-surface = false
resize-overlay = never

# cursor
cursor-style = bar
cursor-style-blink = true
shell-integration-features = no-cursor

# "pop" while typing, like the Serpantinum inputs
custom-shader = shaders/serp-trail.glsl
custom-shader = shaders/serp-pop.glsl
custom-shader-animation = true

# varios
mouse-hide-while-typing = true
copy-on-select = false
scrollback-limit = 10000000
app-notifications = no-clipboard-copy,no-config-reload
