# Cava config for widgets3: fullscreen visualizer rendered by
# Quickshell (no ncurses -- QML draws the bars). method=raw prints each
# bar's values to stdout instead of drawing them in the terminal;
# ~/.config/quickshell/widgets3/shell.qml reads that output directly.
# framerate is controlled by `widgets3 opti on|off` (see widget-opti-common.sh).

[general]
framerate = 60
bars = 64

[input]
method = pulse
source = easyeffects_sink.monitor

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 1000
bar_delimiter = 59
frame_delimiter = 10
channels = mono

[smoothing]
noise_reduction = 85
monstercat = 1
waves = 0
gravity = 120

[eq]
1 = 0.8
2 = 0.9
3 = 1.0
4 = 1.1
5 = 1.2
