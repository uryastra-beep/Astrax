# Cava config for the widgets4 mini visualizer (part of the mini desktop's
# "Now Playing" combo). method=raw like widgets2/widgets3 --
# ~/.config/quickshell/widgets4/shell.qml draws it. Fewer bars than
# widgets3 (mini, not fullscreen). framerate is controlled by `widgets4 opti on|off`.

[general]
framerate = 60
bars = 28

[input]
method = pulse
source = easyeffects_sink.monitor

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 1000
bar_delimiter = 59
frame_delimiter = 10
channels = mono

[smoothing]
noise_reduction = 85
monstercat = 1
waves = 0
gravity = 120

[eq]
1 = 0.8
2 = 0.9
3 = 1.0
4 = 1.1
5 = 1.2
