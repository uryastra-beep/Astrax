# Cava config ONLY for the small taskbar bars (raw output,
# not the visual window). Low bar count because the space is small.

[general]
bars = 10
framerate = 30

[input]
method = pulse
source = easyeffects_sink.monitor

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
noise_reduction = 77
monstercat = 1
