{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/arch-cachy/fastfetch_logo-archcachy-ascii.txt",
    "type": "file-raw",
    "padding": {
      "top": 1,
      "bottom": 1,
      "left": 3,
      "right": 3
    }
  },
  "general": {
    "detectVersion": false
  },
  "display": {
    "separator": "  ",
    "brightColor": false,
    "key": {
      "type": "both-2"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{#}@{host-name-colored} {#}{cwd}" },
    { "type": "break" },
    { "type": "os", "key": "System       " },
    { "type": "kernel", "key": "Kernel       " },
    { "type": "wm", "key": "Desktop      " },
    { "type": "shell", "key": "Shell        " },
    { "type": "cpu", "key": "CPU          " },
    { "type": "gpu", "key": "GPU          " },
    { "type": "memory", "key": "Memory       " },
    { "type": "disk", "key": "Storage /    ", "folders": "/" },
    { "type": "disk", "key": "Storage /home", "folders": "/home" }
  ]
}
