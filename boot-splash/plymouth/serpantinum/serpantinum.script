// Serpantinum boot splash (astrax)
// Matches the Hyprland intro/outro (astrax-intro / astrax-power-wave): background
// = theme base color and the "off" (grey) logo at the same place and size
// the intro draws it. On login the intro lights it up and the waves drop; on
// shutdown the outro ends the same way (grey logo over base) and this follows.
// BASE_* and logo-off.png are generated by boot-splash/sync-theme.sh from the theme.
BASE_R = 0.0667; BASE_G = 0.0510; BASE_B = 0.0706;
Window.SetBackgroundTopColor(BASE_R, BASE_G, BASE_B);
Window.SetBackgroundBottomColor(BASE_R, BASE_G, BASE_B);

W = Window.GetWidth(); H = Window.GetHeight();
// the intro: logo of min(200, height*0.22) logical px, centre 20px above the
// middle (on the laptop at scale 1.25 = height*0.22 and 25 physical px)
size = H * 0.22; if (size > 250) size = 250;
cx = Window.GetX() + W / 2; cy = Window.GetY() + H / 2 - 25;

logo_img = Image("logo-off.png").Scale(size, size);
logo = Sprite(logo_img);
logo.SetPosition(cx - size / 2, cy - size / 2, 3);
logo.SetOpacity(1);

// --- password (in case the disk is ever encrypted) ---
entry_img = Image("entry.png");
bullet_img = Image("bullet.png");
entry = Sprite(); bullets = [];
fun display_password_cb(prompt, n) {
    entry.SetImage(entry_img);
    entry.SetPosition(cx - 150, cy + size / 2 + 60, 5);
    for (i = 0; i < 32; i++) { if (bullets[i]) bullets[i].SetOpacity(0); }
    for (i = 0; i < n && i < 20; i++) {
        bullets[i] = Sprite(bullet_img);
        bullets[i].SetPosition(cx - 140 + i * 14, cy + size / 2 + 72, 6);
    }
}
fun display_normal_cb() {
    entry.SetImage(Image.Text("", 0, 0, 0));
    for (i = 0; i < 32; i++) { if (bullets[i]) bullets[i].SetOpacity(0); }
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);
Plymouth.SetDisplayNormalFunction(display_normal_cb);

msg = Sprite();
fun message_cb(text) {
    msg.SetImage(Image.Text(text, 0.6, 0.55, 0.62));
    msg.SetPosition(cx - 200, cy + size / 2 + 110, 5);
}
Plymouth.SetMessageFunction(message_cb);
