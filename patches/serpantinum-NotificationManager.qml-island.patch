+                           "icon": r.icon || d.iconPath || "", "entry": r.desktopEntry ? r.desktopEntry.id : "", "image": d.image || "", "ts": d.timestamp,
+                           "read": d.read, "urgency": d.urgency });
+            }
+            return JSON.stringify(out);
+        }
+    }
