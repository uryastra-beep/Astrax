# local secrets / machine-specific values (Astrax itself needs no API keys)
.env
.env.*
!.env.example

# editor / backup leftovers
*.bak
*.bak.*
*.backup-*
_pre-*
__pycache__/
*.pyc
.DS_Store
renderer.log

# optional downloads that must never be committed (installed by astrax-icons / astrax-iphone)
apple-icons/
**/apple-icons/
iphone-notifications/
ancs-linux
*.AppImage
